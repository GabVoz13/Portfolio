# SUBMITTING YOUR EXAM:
# When you are finished, upload BOTH the schema and the XML file to Canvas using the posted upload point for this exam. 
# You may zip the files to submit them just as you have done for homework assignments.
start = article
article = element article {mixed{ (head | body)*}} #11GV:fixed mixed content to allow head and body
head = element head {titleLine, headLine+} #4GV: defined headline and allowed headLine to have multiples
headLine = element headLine {n+, mixed{ (newspaper | money | shift)* } } #5GV: defined headLine and added container elements and attribute with mixed content
titleLine = element titleLine {mixed{(newspaper, date), num?, series?}} #GV15:added series into mixed content
shift = element shift {dur, text} #6GV:defined shift & added containers
dur = attribute dur {text} #7GV: defined dur
money = element money {amount, unit, text} #8GV:defined money
unit = attribute unit {text} #9GV:defined unit
newspaper = element newspaper {text} #14GV:removed "empty" and added "text"
date = element date {when, text} #3GV: had to define when
when = attribute when {xsd:date | xsd:gYearMonth |xsd:gYear} #4GV: definition of when
num = element num {amount, text}
amount = attribute amount {xsd:double} #1GV: allows the USD amount as a decimal
series = element series {text}
n = attribute n {xsd:integer} #2GV: added integar to specify the number
body = element body {p+} #12GV: added "+" to allow multiples
p = element p {mixed {(company | address | description)*}} #13:added "mixed" and removed "text"
company = element company {text}
address = element address {type, text}
type = attribute type {"exact" | "general"} #10GV:removed coma, added straight bracket
description = element description {mixed{(company|address)*}}


